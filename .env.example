DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=config_web
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# En developpement, Django affiche les emails dans le terminal.
# Hors debug, settings.py utilise SMTP avec les valeurs ci-dessous.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@gp7.local

# Le proxy frontal envoie /admission/ vers l'application admission_ueh.
ADMISSION_PORTAL_URL=/admission/