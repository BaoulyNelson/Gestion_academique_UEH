{% extends "base_gp7.html" %}
{% block titre %}Choix des cours | GP7{% endblock %}
{% block contenu %}
    <div class="application">
        <main class="contenu-principal">
            <header class="entete-page">
                <div>
                    <p class="fil-ariane">GP7 <span>/</span> {{ inscription.programme.nom }}</p>
                    <h1>Choix des cours</h1>
                </div>
                {% include "partials/identite_utilisateur.django" %}
            </header>
            <section class="bienvenue">
                <div>
                    <p class="surtitre">{{ inscription.periode.nom }} · {{ inscription.periode.annee_academique }}</p>
                    <h2>{{ inscription.programme.nom }}</h2>
                    <p>Choisissez les cours proposes pour cette periode. Tous les cours obligatoires doivent etre inclus.</p>
                </div>
                <div class="bienvenue-marque" aria-hidden="true"><span>UEH</span><span class="marque-point">&#8203;</span><span class="marque-point">&#8203;</span><span class="marque-point">&#8203;</span></div>
            </section>
            {% for message in messages %}<div class="alerte" role="status">{{ message }}</div>{% endfor %}
            {% if peut_modifier %}
                <section class="section-tableau" style="margin-top: 18px;">
                    <div class="section-entete">
                        <div>
                            <p class="surtitre">COURS OFFERTS</p>
                            <h2>Selection de la periode</h2>
                        </div>
                    </div>
                    <form method="post"
                          class="formulaire-connexion"
                          style="padding: 22px;
                                 margin: 0">
                        {% csrf_token %}
                        {{ formulaire.non_field_errors }}
                        {{ formulaire.cours.errors }}
                        <div class="liste-cours-choix">{{ formulaire.cours }}</div>
                        <button class="bouton-principal"
                                type="submit">Enregistrer mon choix <span aria-hidden="true">→</span></button>
                    </form>
                </section>
            {% else %}
                <section class="message-role" role="status">
                    <strong>La periode est fermee aux modifications.</strong>
                    <p>Les cours de votre inscription restent consultables ci-dessous.</p>
                </section>
            {% endif %}
            <section class="section-tableau" style="margin-top: 18px;">
                <div class="section-entete">
                    <div>
                        <p class="surtitre">INSCRIPTION VALIDEE</p>
                        <h2>Cours actuellement choisis</h2>
                    </div>
                </div>
                {% if cours_selectionnes %}
                    <div class="tableau-defilement">
                        <table>
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Cours</th>
                                    <th>Type</th>
                                    <th>Credits</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for selection in cours_selectionnes %}<tr><td><strong>{{ selection.cours.code }}</strong></td><td>{{ selection.cours.nom }}</td><td>{% if selection.cours.est_obligatoire %}Obligatoire{% else %}Optionnel{% endif %}</td><td>{{ selection.cours.credits }}</td></tr>{% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="etat-vide">
                        <span class="etat-vide-symbole" aria-hidden="true">→</span>
                        <div>
                            <strong>Aucun cours choisi</strong>
                            <p>Les cours de cette periode seront affiches ici apres leur enregistrement.</p>
                        </div>
                    </div>
                {% endif %}
            </section>
        </main>
    </div>
{% endblock %}
